PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/kuberagold
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRE=7d
# Website origin(s), comma-separated. "*" may replace one name part for Vercel previews:
# CLIENT_URL=https://kuberagold.com,https://kuberagold-frontend-*.vercel.app
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway) so rate limits see real client IPs
# TRUST_PROXY=1
# Hidden staff sign-up page (/staff-register) requires this key (min 12 chars). Leave unset to close registration.
# REGISTRATION_SECRET=choose_a_long_private_key
# Role given to new sign-ups: admin or guest (never superadmin)
REGISTRATION_ROLE=admin
